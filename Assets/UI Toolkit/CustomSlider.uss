#MySlider Label {
    display: none;
}

#MySlider #unity-tracker {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
}

#MySlider #unity-drag-container {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-top: 0;
}

#MySlider VisualElement {
}

#TextField #unity-text-input {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgb(42, 47, 58);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

#TextField #unity-text-input TextElement {
    color: rgb(203, 213, 225);
    opacity: 1;
    background-position-x: center;
}
